{
  "app": "BCFTaskFlow",
  "version": "0.5.0",
  "apiBase": "https://open21.connect.trimble.com/bcf/3.0/projects",
  "storage": "compressed-v3-in-parent-topic-description",
  "schemaVersion": 2,
  "completedStatuses": [
    "done",
    "closed",
    "completed",
    "resolved",
    "ferdig"
  ],
  "maxSubtasks": 100,
  "notes": "v2 metadata leses automatisk. Nye lagringer bruker komprimert v3-format med kontroll mot BCF API-grense 2048 tegn. Større datamengder krever separat prosjektlagring.",
  "weightScale": {
    "min": 1,
    "max": 5,
    "default": 3
  },
  "completionOptions": [
    0,
    25,
    50,
    75,
    100
  ],
  "progressFormula": "sum(weight * completion/100) / sum(weight) * 100",
  "descriptionMaxLength": 2048
}
