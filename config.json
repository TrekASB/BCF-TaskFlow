{
  "app": "BCFTaskFlow",
  "version": "0.4.0",
  "apiBase": "https://open21.connect.trimble.com/bcf/3.0/projects",
  "storage": "parent-topic-description",
  "schemaVersion": 2,
  "completedStatuses": [
    "done",
    "closed",
    "completed",
    "resolved",
    "ferdig"
  ],
  "maxSubtasks": 100,
  "notes": "Underoppgaver lagres i et merket JSON-blokk på hovedsakens description. Ingen separate BCF Topics blir opprettet.",
  "weightScale": {
    "min": 1,
    "max": 5,
    "default": 3
  },
  "completionOptions": [
    0,
    25,
    50,
    75,
    100
  ],
  "progressFormula": "sum(weight * completion/100) / sum(weight) * 100"
}
